{
  "manifestVersion": 2,
  "id": "token-reminder",
  "name": "Token Reminder",
  "version": "0.1.0",
  "description": "Shows in the status bar how much of each AI plan is still unused and warns before a reset throws it away.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "commands": [
      {
        "id": "token-reminder.refresh",
        "title": "Token Reminder: Refresh usage"
      }
    ],
    "statusBarItems": [
      {
        "id": "unused-plan",
        "icon": "bell",
        "text": "Reading usage",
        "tooltip": "Token Reminder",
        "command": "token-reminder.refresh"
      }
    ]
  },
  "capabilities": []
}
