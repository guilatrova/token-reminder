{
  "manifestVersion": 2,
  "id": "token-reminder",
  "name": "Token Reminder",
  "publisher": "guilatrova",
  "license": "MIT",
  "version": "0.1.0",
  "description": "Don't lose all your tokens nor resets! Get reminders before unused Claude, Codex, and Grok usage limits reset.",
  "cover": {
    "path": "assets/cover.png",
    "alt": "Use all your tokens in time! Token Reminder showing remaining plan usage and reset times."
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "usage",
        "title": "Token Reminder",
        "icon": "gauge",
        "entry": "src/panel/index.html"
      }
    ],
    "commands": [
      {
        "id": "token-reminder.toggle-sidebar",
        "title": "Token Reminder: Toggle the right sidebar",
        "action": "sidebar.right.toggle"
      }
    ],
    "statusBarItems": [
      {
        "id": "unused-plan",
        "icon": "gauge",
        "text": "Reading usage",
        "tooltip": "Token Reminder",
        "command": "token-reminder.toggle-sidebar"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
